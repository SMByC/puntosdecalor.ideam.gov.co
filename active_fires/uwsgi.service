#
# Systemd service for uWSGI - Active Fires
#
# Install:
#   sudo cp active_fires/uwsgi.service /etc/systemd/system/uwsgi.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable uwsgi
#   sudo systemctl start uwsgi
#
# Logs:
#   journalctl -u uwsgi -f
#   (uwsgi.ini deliberately sets no `logto`, so everything lands here)
#

[Unit]
Description=uWSGI instance to serve Active Fires
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=activefires
Group=nginx
WorkingDirectory=/home/activefires/apps/Active_Fires/active_fires
# No `-` prefix: a missing or unreadable .env must fail the unit loudly. With
# it, systemd started anyway and settings.py fell back to defaults — a publicly
# known DJANGO_SECRET_KEY signing real sessions and CSRF tokens. Keep the file
# as plain KEY=value lines (no `export`, no shell expansion, no command
# substitution) so systemd and the crontabs' `set -a; source` read it alike;
# systemd skips lines it cannot parse, and settings.py then refuses to start.
EnvironmentFile=/home/activefires/apps/Active_Fires/.env

ExecStart=/home/activefires/.local/bin/uwsgi --ini uwsgi.ini
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -INT $MAINPID

RuntimeDirectory=uwsgi
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
Type=notify
StandardOutput=journal
StandardError=journal
NotifyAccess=all

# security hardening
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
