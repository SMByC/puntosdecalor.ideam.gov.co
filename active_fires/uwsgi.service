#
# Systemd service for uWSGI - Active Fires
#
# Install:
#   sudo cp active_fires/uwsgi.service /etc/systemd/system/uwsgi.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable uwsgi
#   sudo systemctl start uwsgi
#
# Logs:
#   journalctl -u uwsgi -f
#

[Unit]
Description=uWSGI instance to serve Active Fires
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=activefires
Group=nginx
WorkingDirectory=/home/activefires/apps/Active_Fires/active_fires
EnvironmentFile=-/home/activefires/apps/Active_Fires/.env

ExecStart=/usr/bin/uwsgi --ini uwsgi.ini
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -INT $MAINPID

RuntimeDirectory=uwsgi
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
Type=notify
StandardOutput=journal
StandardError=journal
NotifyAccess=all

# security hardening
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
